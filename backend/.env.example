# Copy to .env and adjust as needed.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./shopdesk.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed an empty database on startup.
AUTO_SEED=true
DEFAULT_SEED=42

# Admin endpoints (/api/admin/seed, /api/admin/reset).
# Turn off in production, or set a token and send it as X-Admin-Token.
ADMIN_ENABLED=true
ADMIN_TOKEN=

# AI (Groq). Get a key at https://console.groq.com/keys
# The /api/ai endpoints return 503 until this is set.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
